<Window x:Class="GestiuneTransport.WpfApp.CursaDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalii cursa"
        Height="620"
        Width="780"
        MinHeight="560"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0C2C32" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#4B5F5B" />
        <SolidColorBrush x:Key="LineBrush" Color="#C1D2D0" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#C9D8D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}"
                CornerRadius="8"
                Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Ruta}"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ClientAfisare}"
                               Foreground="#B9D7D4"
                               FontSize="15"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#F5C15A"
                        CornerRadius="8"
                        Padding="14,8"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding Status}"
                               Foreground="#102B35"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Plecare" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding LocPlecare}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="{Binding DataPlecare, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Destinatie" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Destinatie}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="{Binding DataSosire, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Masina" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding MasinaAfisare}" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Sofer" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SoferAfisare}" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Prioritate" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Prioritate}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Distanta" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding DistantaKm, StringFormat={}{0:N0} km}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Pret / km" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding PretPerKm, StringFormat={}{0:N2} lei}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Cost estimativ" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding CostEstimativ, StringFormat={}{0:N0} lei}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Marfa si observatii" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Marfa}" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Observatii}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Inchide"
                    MinWidth="110"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
